########## base ##########
APP_ENV=dev
APP_TZ=Asia/Shanghai
ORCH_PORT=8000
JWT_TTL_MIN=120
CORS_ORIGINS=http://localhost:5173

########## source & cache ##########
DATABASE_URL=sqlite:///./atelier.db
REDIS_URL=redis://localhost:6379/0
REDIS_STATE_TTL_S=86400

########## object storage ##########
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-guangzhou
S3_BUCKET=tryon
S3_PUBLIC_BASE=http://localhost:9000/tryon
S3_KEEP_ORIGINAL=true
S3_LIFECYCLE_RAW_DAYS=180

########## idempotency & version ##########
PIPELINE_VER=r15.1
SEED_NS=fashn15-qwen2511-r1
IDEM_KEY_LEN=32

########## L3 Provider routing ##########
PROVIDER_DEFAULT=fashn_local
FASHN_LOCAL_URL=http://127.0.0.1:7868
FASHN_LOCAL_TIMEOUT_S=60
FASHN_LOCAL_HEALTHY_P95_S=14
FASHN_LOCAL_MAX_QUEUE=60
FAL_API_KEY=
FAL_MODEL=fal-ai/fashn/tryon/v1.5
FAL_TIMEOUT_S=90
LEAP_API_KEY=
ALIYUN_KEY=
ALIYUN_OUTFIT_MODEL=aitryon-plus
ALIYUN_PARSING_MODEL=aitryon-parsing-v1
PROVIDER_COST_OVERRIDE_CENT=

########## generation defaults ##########
VTON_CATEGORY_DEFAULT=tops
VTON_GARMENT_PHOTO_TYPE=flat-lay
VTON_SEGMENTATION_FREE=true
VTON_STEPS_INTERACTIVE=30
VTON_STEPS_BATCH=30
VTON_STEPS_HERO=50
VTON_GUIDANCE=1.5
VTON_NUM_SAMPLES=1
VTON_SEED_SERVER_PINNED=true
VTON_MAX_SIDE_IN=1920
VTON_OUT_NATIVE=576x864

########## Celery / 3 queues ##########
CELERY_BROKER=redis://localhost:6379/1
CELERY_BACKEND=redis://localhost:6379/2
CELERY_ACKS_LATE=true
CELERY_REJECT_ON_WORKER_LOST=true
CELERY_PREFETCH=1
CELERY_TASK_TIME_LIMIT_S=420
CELERY_TASK_SOFT_TIME_LIMIT_S=360
CELERY_RESULT_EXPIRES_S=3600
Q_INTERACTIVE_RESERVE_PCT=30
Q_BATCH_NIGHT_WEIGHT=2.0
GPU_WARMUP_ON_START=true
GPU_OOM_COOLDOWN_S=60

########## POSTFX (r13 banded) ##########
POSTFX_ENABLED=true
POSTFX_PROFILE=banded
POSTFX_LAB_L_FROM=raw
POSTFX_LAB_AB_MIX=0.80
POSTFX_BAND_SOBEL_KSIZE=3
POSTFX_BAND_GAIN=0.30
POSTFX_BAND_MAX=0.55
POSTFX_MASK_FEATHER_PX=8
POSTFX_EDGE_WRAP_PX=3
POSTFX_HIST_ANCHOR=true
POSTFX_CHROMA_GUARD_DELTA_E=6
POSTFX_WORKERS=6

########## review & QC ##########
REVIEW_REQUIRED=true
REVIEW_AUTO_PASS_CONF=0.0
QC_LOGO_SSIM_MIN=0.72
QC_STRIPE_PERIOD_TOL=0.08
QC_FACE_COS_MAX=0.55
QC_NSFW_MAX=0.02

########## synthetic person (cast) ##########
CAST_MODEL=qwen-image-edit-2511
CAST_MODEL_URL=http://127.0.0.1:8001
CAST_BATCH=8
CAST_LOCK=["bone","skin","makeup","hair"]
CAST_FREE=["pose","light","bg"]
CAST_EXPR_BAN=["grin","teeth"]
CAST_TATTOO=false
CAST_MIN_USE_BEFORE_PROD=50
PERSON_PICK_L1_STICKY=true
PERSON_PICK_L2_DELTA_E_MIN=12
PERSON_PICK_L3_BALANCE=true

########## cost & breaker ##########
BUDGET_SKU_DAY_CENT=800
BUDGET_TENANT_MONTH_CENT=900000
BUDGET_ALERT_WEBHOOK=
COST_LEDGER_DOUBLE_ENTRY=true
CACHE_HIT_ALERT_MIN_PCT=35
PROVIDER_BREAKER_ERR_PCT=15
PROVIDER_BREAKER_WINDOW_S=60
HTTP_402_IS_FATAL=true
HTTP_429_RESPECT_RETRY_AFTER=true

########## render (L4) ##########
RENDERER_URL=http://localhost:3001
RENDER_OUT=[{"w":800,"h":800,"tag":"tb_main"},{"w":750,"h":1000,"tag":"details"},{"w":1242,"h":1660,"tag":"dy"}]
RENDER_PIXEL_RATIO=2
RENDER_FMT={"still":"png","web":"webp","webp_quality":86}
RENDER_FONTS_DIR=/workspace/gzm-design/public/fonts
RENDER_AIGC_STAMP=explicit+implicit
RENDER_HOTSPOT=true
RENDER_CONCURRENCY=4

########## compliance ##########
COMPLIANCE_AIGC_LABEL=1
COMPLIANCE_PERSON_SYNTHETIC_FLAG=true
COMPLIANCE_COPY_BAN=["实拍","真人模特","真实模特试穿","明星同款脸","原相机"]
COMPLIANCE_COPY_FORCE=AI虚拟模特演绎，版型数据取自实物量体，请以尺码表为准
COMPLIANCE_SIZE_FROM=physical_only
COMPLIANCE_PRINT_IP_CHECK=true
